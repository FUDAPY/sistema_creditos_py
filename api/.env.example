# ─────────────────────────────────────────────────────────────
# SysCreditos API — variables de entorno (copiar a api/.env)
# ─────────────────────────────────────────────────────────────

# Puerto HTTP de la API
PORT=3000

# Empresa (tenant) por defecto
COMPANY_ID=lin_group_sa_001

# ── MongoDB ─────────────────────────────────────────────────
# 3 formas de conexión (usa UNA, según dónde corra la API):
#
# 1) LOCAL (docker-compose de este repo, deploy/.env):
MONGO_URI=mongodb://giuli:CAMBIAR_PASSWORD@localhost:27017/syscreditos?authSource=admin&directConnection=true
#
# 2) INTERNA DOKPLOY (API desplegada en el mismo server que Mongo;
#    usa el hostname interno del contenedor de la BD):
# MONGO_URI=mongodb://giuli:CAMBIAR_PASSWORD@creditos-creditos-5ngjs4:27017/syscreditos?authSource=admin
#
# 3) EXTERNA (desde tu PC hacia el VPS; requiere publicar puerto 27017
#    en Dokploy y abrir el firewall; IP = la de tu VPS):
# MONGO_URI=mongodb://giuli:CAMBIAR_PASSWORD@IP_DEL_VPS:27017/syscreditos?authSource=admin

# ── Auth JWT ─────────────────────────────────────────────────
JWT_SECRET=cambiar-por-secreto-largo-aleatorio
JWT_EXPIRES_IN=8h

# CORS permitido (frontend). "*", o lista separada por comas.
# Producción: https://creditos.lingroupsapy.com
CORS_ORIGIN=http://localhost:5173,https://creditos.lingroupsapy.com

# ── Seed del primer ADMIN (npm run seed) ─────────────────────
SEED_ADMIN_EMAIL=admin@lingroup.com
SEED_ADMIN_PASSWORD=cambiar-min-6-caracteres

