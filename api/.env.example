# ─────────────────────────────────────────────────────────────
# SysCreditos API — variables de entorno (copiar a api/.env)
# ─────────────────────────────────────────────────────────────

# Puerto HTTP de la API
PORT=3000

# Empresa (tenant) por defecto
COMPANY_ID=lin_group_sa_001

# ── MongoDB ─────────────────────────────────────────────────
# 3 formas de conexión (usa UNA, según dónde corra la API):
#
# 1) LOCAL (docker-compose de este repo, deploy/.env):
MONGO_URI=mongodb://giuli:CAMBIAR_PASSWORD@localhost:27017/syscreditos?authSource=admin&directConnection=true
#
# 2) INTERNA DOKPLOY (API desplegada en el mismo server que Mongo;
#    usa el hostname interno del contenedor de la BD):
# MONGO_URI=mongodb://giuli:CAMBIAR_PASSWORD@creditos-creditos-5ngjs4:27017/syscreditos?authSource=admin
#
# 3) EXTERNA (desde tu PC hacia el VPS; requiere publicar puerto 27017
#    en Dokploy y abrir el firewall; IP = la de tu VPS):
# MONGO_URI=mongodb://giuli:CAMBIAR_PASSWORD@IP_DEL_VPS:27017/syscreditos?authSource=admin

# ── Auth JWT ─────────────────────────────────────────────────
JWT_SECRET=cambiar-por-secreto-largo-aleatorio
JWT_EXPIRES_IN=8h

# CORS permitido (frontend). "*", o lista separada por comas.
# Producción: https://creditos.lingroupsapy.com
CORS_ORIGIN=http://localhost:5173,https://creditos.lingroupsapy.com

# ── Seed del primer ADMIN (npm run seed / auto-provision al arrancar) ──
# Email del primer usuario ADMIN (si ya existe migrado, se promueve a ADMIN y se le
# asigna/resetea la contrasena; el usuario podra cambiarla luego).
SEED_ADMIN_EMAIL=giuliano777gamer@gmail.com
SEED_ADMIN_PASSWORD=cambiar-min-6-caracteres

# ── Integraciones externas (Fase 4: todas DESHABILITADAS) ────
# La reconexion posterior se hace activando cada una con su URL/credenciales.
INTEGRATION_POS_ENABLED=false
# POS (futuro): contrato HTTP GET {INTEGRATION_POS_URL}/creditos (JSON: array o {data|creditos|items|results}).
INTEGRATION_POS_URL=
INTEGRATION_POS_TOKEN=
# Juridico (lin-group-central): el adaptador lee SU MongoDB (solo lectura).
# En Dokploy, si las redes Docker se comparten, usar el hostname interno
#   mongodb://<user>:<pass>@lin-group-lin-group-central-ktwwt2:27017/?authSource=admin
# En desarrollo local (o si no hay red compartida), usar la IP publica con el
# puerto publicado del Mongo juridico. NO versionar credenciales reales.
# Se pueden listar VARIAS URIs separadas por coma (interna, publica): el conector
# prueba cada una en orden hasta conectar (evita el 500 si la red interna no alcanza).
INTEGRATION_JURIDICO_ENABLED=false
INTEGRATION_JURIDICO_URL=
INTEGRATION_JURIDICO_DB=sysjuridico
INTEGRATION_FINANCIERO_ENABLED=false
INTEGRATION_FINANCIERO_URL=
INTEGRATION_FINANCIERO_BRANCH_ID=syscreditos

# ── Creditos externos sincronizados a local (externalCredits) ──
# Auto-sync al arrancar y cada EXTERNAL_CREDIT_SYNC_INTERVAL_MS (default 6h).
# Los sistemas no habilitados simplemente se omiten.
EXTERNAL_CREDIT_AUTO_SYNC=true
EXTERNAL_CREDIT_SYNC_INTERVAL_MS=21600000


