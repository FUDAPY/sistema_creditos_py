# Copiar a migrator/.env y ajustar (NO se versiona).
# Si se omite FIRESTORE_SERVICE_ACCOUNT, se autodetecta en sistema_creditos_legacy.

# Ruta al service account del proyecto sys-creditos-lingroup (opcional)
FIRESTORE_SERVICE_ACCOUNT=C:\ruta\a\sys-creditos-lingroup-firebase-adminsdk-XXXXX.json

# Empresa (tenant)
COMPANY_ID=lin_group_sa_001

# MongoDB de destino. REEMPLAZAR <TU_PASSWORD> y elegir UNA conexion:
#  - LOCAL:  mongodb://giuli:<TU_PASSWORD>@localhost:27017/syscreditos?authSource=admin
#  - VPS interno (migrador dentro del VPS): mongodb://giuli:<TU_PASSWORD>@creditos-creditos-5ngjs4:27017/syscreditos?authSource=admin
#  - VPS externo (migrador desde tu PC, con puerto publicado): mongodb://giuli:<TU_PASSWORD>@IP_DEL_VPS:27017/syscreditos?authSource=admin
MONGO_URI=mongodb://giuli:<TU_PASSWORD>@localhost:27017/syscreditos?authSource=admin
