# Copiar a deploy/.env y ajustar (deploy/.env NO se versiona).
# Son las credenciales del MongoDB (local o Dokploy) que usara el docker-compose.

# Usuario/contraseña root del MongoDB (en Dokploy: "Internal Credentials")
MONGO_USERNAME=giuli
MONGO_PASSWORD=cambiar-por-tu-password

# Base de datos principal del sistema
MONGO_DB=syscreditos

# Puerto publicado en el host
MONGO_PORT=27017
